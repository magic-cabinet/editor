{
  "name": "@magic-cabinet/pascal-plugin",
  "version": "0.1.0",
  "description": "Magic Cabinet product plugin and pilot showroom for Pascal",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./house-shell": {
      "types": "./dist/house-shell.d.ts",
      "import": "./dist/house-shell.js",
      "default": "./dist/house-shell.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "bun test",
    "check-types": "tsgo --noEmit"
  },
  "peerDependencies": {
    "@pascal-app/core": "^0.9.2",
    "@pascal-app/viewer": "^0.9.2",
    "react": "^18 || ^19",
    "three": "^0.185",
    "zod": "^4"
  },
  "dependencies": {
    "@magic-cabinet/engine": "*"
  },
  "devDependencies": {
    "@pascal-app/core": "^0.9.2",
    "@pascal-app/viewer": "^0.9.2",
    "@pascal/typescript-config": "*",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.2",
    "@types/three": "^0.184.0",
    "typescript": "6.0.3"
  },
  "license": "MIT"
}
